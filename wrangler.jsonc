
{
  "name": "nhrp-information-hub",
  "main": "src/index.js",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nhrp-information-hub-db",
      "database_id": "31805e71-2779-4192-b512-0cb1a988fdb2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "nhrp-information-hub-images"
    }
  ]
}
